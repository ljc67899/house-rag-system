    {"id": "E013", "question": "60-90 平米的两居", "expect": {"area_min": 60, "area_max": 90, "rooms": "2室"}},
    {"id": "E014", "question": "90 平米以下的三居", "expect": {"area_max": 90, "rooms": "3室"}},
