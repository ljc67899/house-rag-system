    {"id": "E002", "question": "海淀区 800 万以下的三居", "expect": {"region": "海淀区", "price_max": 800, "rooms": "3室"}},
    {"id": "E003", "question": "丰台区 60 平米的两居", "expect": {"region": "丰台区", "area_min": 54, "rooms": "2室"}},
    {"id": "E004", "question": "通州 精装修 两居", "expect": {"region": "通州区", "decoration": "精装", "rooms": "2室"}},
    {"id": "E005", "question": "南北通透的三居", "expect": {"orientation": "南北", "rooms": "3室"}},
    {"id": "E006", "question": "带电梯的一居", "expect": {"elevator": true, "rooms": "1室"}},

    {"id": "E007", "question": "300 万左右的两居", "expect": {"price_min": 270, "price_max": 330, "rooms": "2室"}},
