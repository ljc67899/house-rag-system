    {"id": "E009", "question": "200-400 万的三居", "expect": {"price_min": 200, "price_max": 400, "rooms": "3室"}},
    {"id": "E010", "question": "顺义区 800 万以上的房子", "expect": {"region": "顺义区", "price_min": 800}},
    {"id": "E011", "question": "600 万以下的一居室", "expect": {"price_max": 600, "rooms": "1室"}},
