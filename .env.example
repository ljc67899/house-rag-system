# 复制为 .env 后填入自己的值；本文件会进版本库，禁止写入真实密钥

# ===== Application =====
APP_NAME=房产智能问答推荐系统
APP_VERSION=2.0.0
DEBUG=true
HOST=0.0.0.0
# 与 run.py 默认值保持一致；改这里即可换端口
PORT=8001
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ===== Database =====
# SQLite (本地开发备用)
# DATABASE_URL=sqlite:///./data/house.db

# MySQL（本项目真实数据库）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/house_rag_system?charset=utf8mb4

# ===== LLM Configuration =====
# 免费方案推荐（注册即送免费额度）：
# 1. 硅基流动:  LLM_API_BASE=https://api.siliconflow.cn/v1
#             LLM_MODEL_NAME=deepseek-ai/DeepSeek-V3
#             新用户送2000万Token，9B以下模型永久免费
# 2. 智谱AI:    LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
#             LLM_MODEL_NAME=glm-4-flash
#             新用户送2000万Token
# 3. 通义千问:  LLM_API_BASE=https://api.siliconflow.cn/v1
#             LLM_MODEL_NAME=deepseek-ai/DeepSeek-V3
#             新用户有免费额度
# 详见 LLM配置指南.md

LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
# 可选：配置后「AI 看房报告」会额外做房源实拍图理解（如 qwen-vl-plus），留空则跳过
LLM_VISION_MODEL=

# ===== Embedding Configuration =====
# api：调用云端嵌入，免下载模型（默认）；local：本地 bge 模型，离线可用但首次需下载
EMBEDDING_TYPE=api
EMBEDDING_API_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ===== Vector Database =====
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vector_db
VECTOR_DB_COLLECTION=house_rag_knowledge

# ===== Document Storage =====
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# ===== RAG Parameters =====
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.5
# 房源向量索引上限（达到库内总数即全量索引）
RAG_HOUSE_INDEX_LIMIT=40000

# 检索链路 —— 召回（稠密 + 稀疏）→ 加权 RRF → cross-encoder 精排 → 小区级去重
# 代码默认开启精排；模板里关掉是为了首次启动不下载 ~1GB 的 reranker 模型。
# 想要最高召回质量就把下面改成 true（会自动下载 BAAI/bge-reranker-base）。
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# ===== HuggingFace Mirror =====
HF_MIRROR=https://hf-mirror.com

# ===== 管理员初始口令 =====
# 首次启动 Admin 表为空时使用；留空则随机生成并只打印在启动日志里。
# 仓库里不写任何默认后台口令，避免公开的「后门账号」。
ADMIN_INIT_PASSWORD=

# ===== 外部地理数据（高德 Web 服务）=====
# 仅用于外地城市的「行政区 / 商圈 / 地铁」地理补全，不含房源价格
AMAP_WEB_KEY=your_amap_web_key_here
EXTERNAL_DATA_TIMEOUT=4
EXTERNAL_DATA_CACHE_TTL=86400

# 检索链路 —— 方案一：不下载 cross-encoder，用加权RRF + 小区级去重
RAG_RERANK_ENABLED=false
AMAP_JS_KEY=your_amap_js_key_here
AMAP_JS_SECURITY_CODE=your_amap_js_security_code_here
